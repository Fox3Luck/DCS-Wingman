# /etc/dcs-wingman/env  (chmod 0600). Generate secrets with: openssl rand -hex 32
WINGMAN_DB=/var/lib/dcs-wingman/wingman.db
WINGMAN_PEPPER=replace-with-64-hex-chars-and-never-rotate-casually
WINGMAN_ADMIN_KEY=replace-with-64-hex-chars
WINGMAN_PRESENCE_TTL=300
WINGMAN_GREET_GAP=1800
# Set to 1 only when uvicorn sits behind a reverse proxy that sets X-Forwarded-For
WINGMAN_TRUST_PROXY=0
